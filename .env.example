# Copie este arquivo para .env (raiz, para o docker compose) ou para src/.env (execução local)
# e preencha os valores.

# OBRIGATÓRIAS (o bot falha ao iniciar sem elas)

BOT_USER_TOKEN=seu token de bot do Discord

# Padrão para o docker compose (serviço db) quando as POSTGRES_* abaixo
# ficam nos defaults:
#   postgres://postgres:postgres@db:5432/laro
# Para execução local (Postgres no host ou no compose, com a porta publicada):
#   postgres://postgres:postgres@localhost:5432/laro
DATABASE_URL=postgres://postgres:postgres@localhost:5432/laro

# CREDS DO POSTGRES DO COMPOSE — interpoladas no docker-compose.yml
# (o docker compose lê o .env da raiz). Os defaults servem só para dev
# local; na VM defina uma senha própria antes do primeiro compose up.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=laro

# OPCIONAIS (o bot usa os valores padrão se não forem definidas)

DEL_MSG_AFTER_SECS=10
TABLE_ENTRY_EXPIRATION_MINS=20
TIMER_DELAY_SECS=5
TIMEZONE=America/Sao_Paulo
# Prefixo dos comandos do bot no chat (mensagens no canal de track só são
# processadas se começarem com esse prefixo)
COMMAND_PREFIX=!
# Sem efeito a partir da versão com comandos por prefixo (não há slash commands)
GUILD_ID=

# MONITORAMENTO (ver docs/hosting-oracle.md)

# Porta do servidor HTTP de healthcheck do bot (GET /health); 0 desliga
HEALTH_PORT=8080
# URL de heartbeat para um monitor externo (UptimeRobot, Better Stack...):
# o bot faz um GET periodicamente e o alarme dispara quando os pings param.
# Vazio = sem heartbeat.
HEARTBEAT_URL=
# Intervalo do heartbeat em segundos
HEARTBEAT_SECS=60
